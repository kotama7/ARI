{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ari://schemas/replication_rubric.schema.json",
  "title": "ARI ReplicationRubricV2 (PaperBench TaskNode compatible)",
  "type": "object",
  "required": ["schema_version", "version", "paper_sha256", "generator", "repair_ledger", "reproduce_contract", "rubric", "rubric_sha256"],
  "properties": {
    "schema_version": { "const": "ari.replication-rubric/v2" },
    "version":        { "const": "3" },
    "paper_sha256":   { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rubric_sha256":  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator": {
      "type": "object",
      "required": ["model", "provider", "prompt_sha256", "generated_at", "strategy", "quality_profile", "max_model_calls", "subtree_concurrency", "calls", "partial_failures"],
      "properties": {
        "model":          { "type": "string" },
        "model_revision": { "type": ["string", "null"] },
        "provider":       { "type": "string" },
        "prompt_sha256":  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_at":   { "type": "string", "format": "date-time" },
        "temperature":    { "type": "number" },
        "seed":           { "type": "integer" },
        "snapshot":       { "type": "object" },
        "strategy":       { "enum": ["hierarchical-v2", "legacy-v1-offline-migration"] },
        "quality_profile": { "enum": ["calibrated", "requires-independent-audit"] },
        "max_model_calls": { "type": "integer", "minimum": 0, "maximum": 256 },
        "subtree_concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/model_call" }
        },
        "partial_failures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_artifact": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "repair_ledger": {
      "type": "object",
      "required": ["actions", "dropped_artifacts"],
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/repair_action" }
        },
        "dropped_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "reproduce_contract": {
      "type": "object",
      "description": "Phase 1 execution requirements (PaperBench reproduce.sh contract).",
      "required": ["script_path", "max_runtime_sec"],
      "properties": {
        "script_path":      { "const": "reproduce.sh" },
        "max_runtime_sec":  { "type": "integer", "minimum": 60, "maximum": 43200 },
        "expected_artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "execution_profile": {
          "type": "object",
          "description": "Optional HPC/parallel-execution hints. Compiled into ari.hpc.job-request/v1 and consumed by the BasicAgent prompt. Omit for single-node papers.",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["cpu_single", "gpu_single", "gpu_multi", "mpi", "mpi_gpu"]
            },
            "paper_max_ranks":  { "type": "integer", "minimum": 1 },
            "paper_max_nodes":  { "type": "integer", "minimum": 1 },
            "min_ranks":        { "type": "integer", "minimum": 1, "default": 1 },
            "min_nodes":        { "type": "integer", "minimum": 1, "default": 1 },
            "result_aggregation": {
              "type": "string",
              "enum": ["rank0_csv"]
            },
            "metric_columns": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Required column names in submission/results/*.csv"
            },
            "accepts_reduced_scale": {
              "type": "boolean",
              "default": true
            },
            "requested_nodes":        { "type": "integer", "minimum": 1 },
            "ntasks_per_node":        { "type": "integer", "minimum": 0, "default": 0 },
            "requested_nodelist":     { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9,._+\\[\\]-]{0,1023}$" },
            "exclude_nodes":          { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9,._+\\[\\]-]{0,1023}$", "default": "" },
            "exclusive":              { "type": "boolean", "default": false },
            "requested_gpus_per_task":{ "type": "integer", "minimum": 0, "default": 0 },
            "requested_gpus_per_node":{ "type": "integer", "minimum": 0, "default": 0 },
            "gpu_type":               { "type": "string", "default": "" },
            "memory_gb_per_node":     { "type": "integer", "minimum": 0, "default": 0 },
            "memory_gb_per_cpu":      { "type": "integer", "minimum": 0, "default": 0 },
            "constraint":             { "type": "string", "default": "" },
            "cpu_bind":               { "type": "string", "default": "" },
            "mem_bind":               { "type": "string", "default": "" },
            "hint":                   { "enum": ["", "compute_bound", "memory_bound", "multithread", "nomultithread"], "default": "" },
            "account":                { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$", "default": "" },
            "qos":                    { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$", "default": "" },
            "reservation":            { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$", "default": "" },
            "module_loads": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "extra_sbatch_args": {
              "type": "array",
              "description": "Deprecated reader compatibility; new producers must use typed fields.",
              "items": {
                "type": "string",
                "pattern": "^--(account|qos|reservation|hint)=[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$"
              },
              "default": []
            }
          },
          "allOf": [
            {
              "not": {
                "required": ["memory_gb_per_node", "memory_gb_per_cpu"],
                "properties": {
                  "memory_gb_per_node": { "minimum": 1 },
                  "memory_gb_per_cpu": { "minimum": 1 }
                }
              }
            },
            {
              "not": {
                "required": ["requested_gpus_per_task", "requested_gpus_per_node"],
                "properties": {
                  "requested_gpus_per_task": { "minimum": 1 },
                  "requested_gpus_per_node": { "minimum": 1 }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rubric": {
      "$ref": "#/$defs/task_node",
      "description": "Root TaskNode (PaperBench-compatible). Pass this directly to SimpleJudge."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["relative_path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "model_call": {
      "type": "object",
      "required": ["label", "status", "model", "provider", "prompt", "call_sha256"],
      "properties": {
        "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "status": { "enum": ["completed", "failed", "budget-exhausted"] },
        "model": { "type": "string", "minLength": 1 },
        "model_revision": { "type": ["string", "null"] },
        "provider": { "type": "string", "minLength": 1 },
        "prompt": { "$ref": "#/$defs/artifact" },
        "raw_response": { "$ref": "#/$defs/artifact" },
        "error": { "type": ["string", "null"] },
        "call_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": { "required": ["raw_response"] }
        }
      ],
      "additionalProperties": false
    },
    "repair_action": {
      "type": "object",
      "required": ["sequence", "action", "target", "before_sha256", "after_sha256", "reason"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["json-sanitize", "default-field", "identity-normalize", "category-normalize", "structure-collapse", "leaf-field-strip", "evidence-bind", "verification-bind", "invalid-prune", "partial-subtree", "legacy-migrate"] },
        "target": { "type": "string", "minLength": 1 },
        "before_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "after_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 1 },
        "dropped_artifact": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "evidence_span": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "section", "quote", "start_char", "end_char", "paper_sha256"],
          "properties": {
            "kind": { "const": "paper-span" },
            "section": { "type": "string", "minLength": 1 },
            "quote": { "type": "string", "minLength": 10 },
            "start_char": { "type": "integer", "minimum": 0 },
            "end_char": { "type": "integer", "minimum": 1 },
            "paper_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "description", "source"],
          "properties": {
            "kind": { "const": "external-prerequisite" },
            "description": { "type": "string", "minLength": 10 },
            "source": { "type": "string", "minLength": 3 }
          },
          "additionalProperties": false
        }
      ]
    },
    "verification_target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "relative_path"],
          "properties": {
            "kind": { "const": "artifact" },
            "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "relative_path", "pattern"],
          "properties": {
            "kind": { "const": "log-pattern" },
            "relative_path": { "const": "reproduce.log" },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "relative_path", "metric", "unit"],
          "properties": {
            "kind": { "const": "metric" },
            "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
            "metric": { "type": "string", "minLength": 1 },
            "unit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "task_node": {
      "type": "object",
      "required": ["id", "requirements", "weight"],
      "properties": {
        "id":           { "type": "string", "format": "uuid" },
        "requirements": { "type": "string", "minLength": 10 },
        "weight":       { "type": "integer", "minimum": 0 },
        "sub_tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task_node" }
        },
        "task_category": {
          "enum": ["Code Development", "Code Execution", "Result Analysis", null]
        },
        "finegrained_task_category": {
          "enum": [
            "Environment & Infrastructure Setup",
            "Dataset and Model Acquisition",
            "Data Processing & Preparation",
            "Method Implementation",
            "Experimental Setup",
            "Evaluation, Metrics & Benchmarking",
            "Logging, Analysis & Presentation",
            null
          ],
          "description": "PaperBench closed vocabulary; mirrors VALID_FINEGRAINED_TASK_CATEGORIES in vendor/paperbench/.../tasks.py."
        },
        "rationale_from_paper": {
          "description": "Required at leaves: exact paper evidence or an explicit external prerequisite.",
          "oneOf": [
            {
              "type": "object",
              "required": ["section", "quote"],
              "properties": {
                "section": { "type": "string", "minLength": 1 },
                "quote":   { "type": "string", "minLength": 10 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["external_prerequisite"],
              "properties": {
                "external_prerequisite": {
                  "type": "object",
                  "required": ["description", "source"],
                  "properties": {
                    "description": { "type": "string", "minLength": 10 },
                    "source": { "type": "string", "minLength": 3 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "evidence_span": { "$ref": "#/$defs/evidence_span" },
        "verification": { "$ref": "#/$defs/verification_target" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sub_tasks": { "maxItems": 0 } },
            "required": ["sub_tasks"]
          },
          "then": {
            "required": ["task_category", "finegrained_task_category", "rationale_from_paper", "evidence_span", "verification"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
