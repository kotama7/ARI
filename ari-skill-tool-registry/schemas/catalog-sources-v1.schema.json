        "semantics_documented": {
          "default": false,
          "title": "Semantics Documented",
          "type": "boolean"
        },
        "units_documented": {
          "default": false,
          "title": "Units Documented",
          "type": "boolean"
        }
      },
      "title": "AdmissionEvidenceV1",
      "type": "object"
