{
  "$defs": {
    "ArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "ari.orchestrator-artifact-ref/v1",
          "default": "ari.orchestrator-artifact-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "artifact_id",
        "digest",
        "role",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRefV1"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "request_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.orchestrator-run-result/v1",
      "default": "ari.orchestrator-run-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "submitted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "request_digest",
    "state"
  ],
  "title": "RunResultV1",
  "type": "object"
}
