{
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "media_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "role": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Role",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.orchestrator-artifact-ref/v1",
      "default": "ari.orchestrator-artifact-ref/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
