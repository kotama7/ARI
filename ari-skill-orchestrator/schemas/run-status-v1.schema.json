{
  "additionalProperties": false,
  "properties": {
    "best_node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Node Id"
    },
    "best_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Score"
    },
    "budget": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Budget",
      "type": "object"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "max_recursion_depth": {
      "maximum": 32,
      "minimum": 0,
      "title": "Max Recursion Depth",
      "type": "integer"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "recursion_depth": {
      "maximum": 32,
      "minimum": 0,
      "title": "Recursion Depth",
      "type": "integer"
    },
    "request_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "root_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Root Run Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.orchestrator-run-status/v1",
      "default": "ari.orchestrator-run-status/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "enum": [
        "submitted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "successful_nodes": {
      "default": 0,
      "minimum": 0,
      "title": "Successful Nodes",
      "type": "integer"
    },
    "total_nodes": {
      "default": 0,
      "minimum": 0,
      "title": "Total Nodes",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "request_digest",
    "principal_id",
    "root_run_id",
    "recursion_depth",
    "max_recursion_depth",
    "state",
    "created_at"
  ],
  "title": "RunStatusV1",
  "type": "object"
}
