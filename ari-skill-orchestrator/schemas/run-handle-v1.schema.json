{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "max_recursion_depth": {
      "maximum": 32,
      "minimum": 0,
      "title": "Max Recursion Depth",
      "type": "integer"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "recursion_depth": {
      "maximum": 32,
      "minimum": 0,
      "title": "Recursion Depth",
      "type": "integer"
    },
    "request_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "reused": {
      "default": false,
      "title": "Reused",
      "type": "boolean"
    },
    "root_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Root Run Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.orchestrator-run-handle/v1",
      "default": "ari.orchestrator-run-handle/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "submitted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "request_digest",
    "principal_id",
    "root_run_id",
    "recursion_depth",
    "max_recursion_depth",
    "state",
    "created_at"
  ],
  "title": "RunHandleV1",
  "type": "object"
}
