{
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "backend_version": {
      "title": "Backend Version",
      "type": "string"
    },
    "binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Binding Digest",
      "type": "string"
    },
    "brief_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Brief Bundle Digest",
      "type": "string"
    },
    "context_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Digest",
      "type": "string"
    },
    "paper_mode": {
      "enum": [
        "linear",
        "rqgm_archive"
      ],
      "title": "Paper Mode",
      "type": "string"
    },
    "profile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Profile Digest",
      "type": "string"
    },
    "readiness_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Readiness Digest",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.manuscript-authoring-binding/v1",
      "default": "ari.manuscript-authoring-binding/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Digest",
      "type": "string"
    },
    "target_build_id": {
      "title": "Target Build Id",
      "type": "string"
    },
    "target_build_revision": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Target Build Revision",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "attempt_id",
    "source_snapshot_digest",
    "profile_digest",
    "context_digest",
    "readiness_digest",
    "brief_bundle_digest",
    "paper_mode",
    "backend_version",
    "target_build_id",
    "target_build_revision",
    "binding_digest"
  ],
  "title": "ManuscriptAuthoringBindingV1",
  "type": "object"
}
