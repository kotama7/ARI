          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Candidate Toolchain",
      "type": "object"
    },
    "case_results": {
      "items": {
        "$ref": "#/$defs/ProblemCorrectnessCaseResultV1"
      },
      "title": "Case Results",
      "type": "array"
    },
    "contention": {
