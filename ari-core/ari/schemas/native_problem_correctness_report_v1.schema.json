{
  "$defs": {
    "ProblemCorrectnessCaseResultV1": {
      "additionalProperties": false,
      "description": "One scored shape. Every measurement is OPTIONAL, and that is the point.\n\nTHE DEFECT THIS SHAPE FIXES. These fields were plain scalars initialised to\n0.0 / 0 / True before the launch loop, and emitted verbatim when no launch\ncompleted -- so a candidate that never ran published\n``worst_residual_ratio: 0.0``, which reads as \"exactly zero error\", and\n``output_elements_written: 0``, which reads as \"the kernel wrote nothing\"\neven when the truth was that nothing was ever read. An attestation carried\nthose numbers as measurements. ``None`` means \"not observed\", which is a\nthing the reader can act on; a default dressed as a measurement is not.",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "output_elements_expected": {
          "minimum": 0,
          "title": "Output Elements Expected",
          "type": "integer"
        },
        "output_elements_written": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Elements Written"
        },
        "repeat_identical": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Identical"
        },
        "repetitions_completed": {
          "minimum": 0,
          "title": "Repetitions Completed",
          "type": "integer"
        },
        "repetitions_requested": {
          "minimum": 0,
          "title": "Repetitions Requested",
          "type": "integer"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "worst_residual_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worst Residual Ratio"
        }
      },
      "required": [
        "case_id",
        "verdict",
        "detail",
        "output_elements_expected",
        "repetitions_requested",
        "repetitions_completed"
      ],
      "title": "ProblemCorrectnessCaseResultV1",
      "type": "object"
    }
  },
  "$id": "ari.native-problem-correctness-report/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The typed result the problem-correctness worker prints and the driver normalizes. Generated from NativeProblemCorrectnessReportV1 so it cannot drift from the model: a registration resolves this file from the drivers declared report type, and result_schema_conformance fails outright when no schema exists for that type.",
  "properties": {
    "accepted_flags": {
