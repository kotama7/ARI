        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Build Error"
    },
    "candidate_digest": {
      "title": "Candidate Digest",
      "type": "string"
    },
    "candidate_toolchain": {
      "additionalProperties": {
