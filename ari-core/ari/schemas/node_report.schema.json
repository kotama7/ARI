{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ari/schemas/node_report.schema.json",
  "title": "ARI node_report.json",
  "description": "Per-BFTS-node self report. Written at mark_success/mark_failed time and consumed by generate_ear, nodes_to_science_data, and bfts.expand.",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "depth",
    "status",
    "files_changed",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ancestor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label": {
      "type": "string",
      "enum": [
        "draft",
        "improve",
        "debug",
        "ablation",
        "validation",
        "other"
      ]
    },
    "raw_label": {
      "type": "string"
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "original_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "files_changed": {
      "type": "object",
      "required": [
        "added",
        "modified",
        "deleted",
        "inherited_unchanged"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256_before": {
                "type": "string"
              },
              "sha256_after": {
                "type": "string"
              }
            }
          }
        },
        "deleted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherited_unchanged": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "from_node_id": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "unhashable": {
          "type": "array",
          "description": "Files the node produced whose sha256 could not be read (e.g. foreign-uid container output). Present only when non-empty. A consumer deciding 'this node produced nothing' must treat a non-empty list as UNKNOWN, never as no changes.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "what_was_done": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "knowledge_skill_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "knowledge_skill_use_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instruction_identity_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capability_binding_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bound_tool_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assurance_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "infrastructure_error",
        "tampered"
      ]
    },
    "assurance_tier": {
      "type": "string",
      "enum": [
        "screen",
        "validate",
        "certify"
      ]
    },
    "baseline_harness_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "active_harness_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attestation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verified_target_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "property_verdicts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "inconclusive",
          "infrastructure_error",
          "tampered"
        ]
      }
    },
    "frontier_class": {
      "type": "string",
      "enum": [
        "scientific_frontier",
        "debug_frontier",
        "uncertified_frontier",
        "invalid"
      ]
    },
    "repair_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "repair_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repair_context_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repair_allowed_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "self_assessment": {
      "type": "object",
      "description": "The node's LLM-generated self-review. `headline` is its summary and `concerns` are its self-flagged caveats; under a rubric/judge scorer concerns may fall back to low (<0.4) evaluator-axis rationales. Objective validity lives only in the top-level `measurement_valid` field.",
      "properties": {
        "succeeded": {
          "type": "boolean"
        },
        "headline": {
          "type": "string"
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_steps_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "build_command": {
      "type": "string"
    },
    "run_command": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "description": "Artifacts the node produced, with role classification.",
      "items": {
        "type": "object",
        "required": [
          "filename",
          "role"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "data_output",
              "log",
              "binary",
              "figure",
              "unknown"
            ]
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "inline": {
            "type": "boolean",
            "description": "True for an inline result blob (captured stdout) that has no file on disk; the provenance audit skips these so they are not reported as a phantom missing artifact."
          }
        }
      }
    },
    "evaluator_reason": {
      "type": "string"
    },
    "trace_log_summary": {
      "type": "string"
    },
    "migration_source": {
      "type": "string",
      "enum": [
        "fresh",
        "auto"
      ]
    },
    "executor": {
      "type": "string",
      "description": "How the node's tool calls executed: 'slurm' (via slurm_submit) | 'local' (run_bash on agent host) | 'singularity' | '' (unknown / no capture)"
    },
    "hostname": {
      "type": "string",
      "description": "Hostname of the compute resource that produced the metrics (set by ari.agent.run_env from inside the executing process)"
    },
    "slurm_job_id": {
      "type": "string"
    },
    "slurm_partition": {
      "type": "string"
    },
    "slurm_nodelist": {
      "type": "string"
    },
    "cpu_info": {
      "type": "object",
      "description": "CPU provenance (populate-as-needed; omitted when not captured).",
      "properties": {
        "model": {
          "type": "string"
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "mhz": {
          "type": "number",
          "minimum": 0
        },
        "arch": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        }
      }
    },
    "mem_total_kb": {
      "type": "integer",
      "minimum": 0
    },
    "compilers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evaluation_cases": {
      "type": "object",
      "description": "Task-independent objective evidence by evaluator-defined case. Case names and measurement names are owned by the harness; the core schema assigns them no domain-specific meaning.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "valid",
          "measurements"
        ],
        "additionalProperties": false,
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "measurements": {
            "type": "object",
            "description": "Harness-defined, JSON-scalar objective observations for this case.",
            "additionalProperties": {
              "type": [
                "number",
                "boolean",
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "evaluation_status": {
      "type": "string",
      "enum": [
        "valid",
        "candidate_invalid",
        "measurement_invalid",
        "infrastructure_error"
      ],
      "description": "Typed evaluator outcome. Infrastructure errors are not scientific zeroes and must be excluded from analysis."
    },
    "measurement_valid": {
      "type": "boolean",
      "description": "Objective evaluator verdict (the node's has_real_data value). Always emitted by the current builder; absent only in legacy reports."
    },
    "measurement_audit": {
      "type": "object",
      "description": "Evaluator-only audit record. It is persisted but never rendered into parent-child handoff text.",
      "required": [
        "effective_candidate_compile_flags",
        "rejected_candidate_compile_flags",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "effective_candidate_compile_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_candidate_compile_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "status",
                "valid",
                "measurements"
              ],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "type": "string"
                },
                "valid": {
                  "type": "boolean"
                },
                "execution_order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Order in which the matched alternatives were executed for this repetition."
                },
                "measurements": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "boolean",
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "case_diagnostics": {
          "type": "object",
          "description": "Per-case observations kept OUT of the handoff on purpose: the regression verdict, the run-to-run spread, what the toolchain bought, and an absolute wall-clock time. evaluation_cases is rendered verbatim into the child's prompt, so a scalar there is treatment text; these are audit material.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "measurement_provenance": {
          "type": "object",
          "description": "Which instrument produced these numbers -- problem revision and digest, case set, report digest, the registered threshold and its verdict. Without it a report holds a speedup with nothing saying which question, which sizes or which frozen bytes it was measured against.",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
