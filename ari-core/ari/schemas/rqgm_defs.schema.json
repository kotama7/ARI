{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ari/schemas/rqgm_defs.schema.json",
  "title": "ARI-RQGM shared definitions",
  "description": "Canonical shared $defs for every RQGM record schema (docs/plans/ari_rqgm/02 §5.5/§6, owned by Task 02): the rqgm_record_base envelope, the closed status/role/tier vocabularies, and the id/hash formats. Later RQGM schemas (Tasks 03/05/06/...) $ref these definitions; the copies embedded in the Task-02 schema files are pinned byte-equal to this file by ari-core/tests/test_rqgm_state_store.py. The Python source of truth is ari/rqgm/events.py.",
  "$defs": {
    "hash12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch_id": {
      "type": "string",
      "pattern": "^epoch_[0-9]{3,}$"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^transition_[0-9]{3,}_to_[0-9]{3,}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9]{6,}$"
    },
    "rqgm_status": {
      "type": "string",
      "enum": [
        "candidate",
        "validated",
        "shadow",
        "probationary_active",
        "active",
        "warning",
        "probation",
        "quarantine",
        "retired",
        "banned"
      ]
    },
    "rqgm_role": {
      "type": "string",
      "enum": [
        "generator",
        "reviewer",
        "adversary",
        "defender",
        "judge",
        "router",
        "prompt_mutator",
        "clean_room_generator",
        "replay_selector",
        "failure_summary_compressor",
        "policy_mutator",
        "utility_policy",
        "paper_writer",
        "paper_reviewer",
        "auditor",
        "evidence_clerk",
        "governance_judge",
        "constitutional_kernel",
        "knowledge_binder",
        "capability_binder",
        "harness_resolver",
        "fixed_verifier",
        "audit_log"
      ]
    },
    "rqgm_tier": {
      "type": "string",
      "enum": [
        "fixed",
        "institutional",
        "meta"
      ]
    },
    "rqgm_record_base": {
      "type": "object",
      "required": [
        "record_id",
        "epoch_id",
        "component_id",
        "prompt_hash",
        "role",
        "created_at",
        "source_refs",
        "status"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "epoch_id": {
          "$ref": "#/$defs/epoch_id"
        },
        "component_id": {
          "type": "string"
        },
        "prompt_hash": {
          "$ref": "#/$defs/hash12"
        },
        "role": {
          "$ref": "#/$defs/rqgm_role"
        },
        "created_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
