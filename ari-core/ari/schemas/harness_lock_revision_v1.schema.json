{
  "$defs": {
    "LockedHarnessV1": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Container Digest",
          "type": "string"
        },
        "covered_atom_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Covered Atom Digests",
          "type": "array"
        },
        "dataset_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Dataset Digest",
          "type": "string"
        },
        "driver_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Driver Digest",
          "type": "string"
        },
        "harness_id": {
          "title": "Harness Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "benchmark",
            "artifact_verifier",
            "reproduction",
            "claim_verifier"
          ],
          "title": "Kind",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "oracle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Oracle Digest",
          "type": "string"
        },
        "result_schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Schema Digest",
          "type": "string"
        },
        "tolerance_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Tolerance Policy Digest",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "harness_id",
        "version",
        "kind",
        "manifest_digest",
        "dataset_digest",
        "oracle_digest",
        "driver_digest",
        "container_digest",
        "result_schema_digest",
        "tolerance_policy_digest",
        "covered_atom_digests"
      ],
      "title": "LockedHarnessV1",
      "type": "object"
    }
  },
  "$id": "https://ari.dev/schemas/harness-lock-revision-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "active_harnesses": {
      "items": {
        "$ref": "#/$defs/LockedHarnessV1"
      },
      "title": "Active Harnesses",
      "type": "array"
    },
    "added_or_strengthened_harnesses": {
      "items": {
        "$ref": "#/$defs/LockedHarnessV1"
      },
      "title": "Added Or Strengthened Harnesses",
      "type": "array"
    },
    "added_requirement_refs": {
      "items": {
        "type": "string"
      },
      "title": "Added Requirement Refs",
      "type": "array"
    },
    "baseline_lock_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseline Lock Digest",
      "type": "string"
    },
    "coverage_proof_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Coverage Proof Digest",
      "type": "string"
    },
    "next_epoch_id": {
      "title": "Next Epoch Id",
      "type": "string"
    },
    "parent_lock_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parent Lock Digest",
      "type": "string"
    },
    "revision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Revision Digest",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.harness-lock-revision/v1",
      "default": "ari.harness-lock-revision/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "next_epoch_id",
    "parent_lock_digest",
    "baseline_lock_digest",
    "added_requirement_refs",
    "added_or_strengthened_harnesses",
    "active_harnesses",
    "coverage_proof_digest",
    "revision_digest"
  ],
  "title": "ARI Harness Lock Revision v1",
  "type": "object"
}
