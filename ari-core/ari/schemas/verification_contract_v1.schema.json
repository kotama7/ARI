{
  "$defs": {
    "VerificationRequirementV1": {
      "additionalProperties": false,
      "properties": {
        "determinism_requirement": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "seeded",
            "declared"
          ],
          "title": "Determinism Requirement",
          "type": "string"
        },
        "failure_policy": {
          "enum": [
            "exclude-from-scientific-frontier",
            "block-publication",
            "record-only"
          ],
          "title": "Failure Policy",
          "type": "string"
        },
        "independence_requirement": {
          "default": "independent",
          "enum": [
            "independent",
            "declared",
            "none"
          ],
          "title": "Independence Requirement",
          "type": "string"
        },
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "required_methods": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Methods",
          "type": "array"
        },
        "required_tier": {
          "enum": [
            "screen",
            "validate",
            "certify"
          ],
          "title": "Required Tier",
          "type": "string"
        },
        "required_verdict": {
          "const": "pass",
          "default": "pass",
          "title": "Required Verdict",
          "type": "string"
        },
        "requirement_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Requirement Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "ari.verification-requirement/v1",
          "default": "ari.verification-requirement/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/VerificationScopeV1"
        },
        "source_requirement_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Requirement Refs",
          "type": "array"
        },
        "target_kind": {
          "title": "Target Kind",
          "type": "string"
        },
        "tolerance_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Tolerance Policy Digest",
          "type": "string"
        },
        "tolerance_policy_ref": {
          "title": "Tolerance Policy Ref",
          "type": "string"
        }
      },
      "required": [
        "property_id",
        "target_kind",
        "required_methods",
        "required_tier",
        "failure_policy",
        "scope",
        "tolerance_policy_ref",
        "tolerance_policy_digest",
        "source_requirement_refs",
        "requirement_digest"
      ],
      "title": "VerificationRequirementV1",
      "type": "object"
    },
    "VerificationScopeV1": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "title": "VerificationScopeV1",
      "type": "object"
    }
  },
  "$id": "https://ari.dev/schemas/verification-contract-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "admission_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Admission Confidence",
      "type": "number"
    },
    "baseline_knowledge_obligation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Baseline Knowledge Obligation Refs",
      "type": "array"
    },
    "contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contract Digest",
      "type": "string"
    },
    "human_review_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Review Identity"
    },
    "property_vocabulary_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Property Vocabulary Digest",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/VerificationRequirementV1"
      },
      "title": "Requirements",
      "type": "array"
    },
    "research_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Research Contract Digest",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.verification-contract/v1",
      "default": "ari.verification-contract/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "research_contract_digest",
    "requirements",
    "admission_confidence",
    "property_vocabulary_digest",
    "contract_digest"
  ],
  "title": "ARI Verification Contract v1",
  "type": "object"
}
