{
  "additionalProperties": false,
  "properties": {
    "artifact_digests": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Artifact Digests",
      "type": "array"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "from_state": {
      "title": "From State",
      "type": "string"
    },
    "parent_transition_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Transition Digest"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ari.manuscript-transition/v1",
      "default": "ari.manuscript-transition/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "to_state": {
      "title": "To State",
      "type": "string"
    },
    "transition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Transition Digest",
      "type": "string"
    }
  },
  "required": [
    "sequence",
    "run_id",
    "attempt_id",
    "from_state",
    "to_state",
    "reason_code",
    "transition_digest"
  ],
  "title": "ManuscriptTransitionV1",
  "type": "object"
}
