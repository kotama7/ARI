# ===========================
# ARI root-level .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
dist/
build/
*.egg
# (.env lives once in the Security section below)

# ── Experiment artifacts (NEVER track) ─────────────────────────
# SLURM job logs & error files. NOTE: `*.out` is intentionally broad —
# it covers both SLURM job output and compiled binaries. Keep this single
# occurrence; do not delete it as a "duplicate".
logs/
*.out
*.err
slurm-*.out

# Checkpoint directories (generated at runtime)
*_ckpt_*/
checkpoints/
# Versioned migration fixtures exercise legacy checkpoint readers in CI.
!/ari-core/tests/fixtures/checkpoints/
!/ari-core/tests/fixtures/checkpoints/**
output*/
results*/

# Experiment-specific source files (user-created, not part of ARI)
experiments/
benchmarks/
*.c

# The registered performance harness's frozen scaffolding is CONTENT-ADDRESSED by
# its manifest and by the driver digest, so a checkout without it cannot verify
# or reproduce a measurement. The blanket *.c above would drop it silently, which
# is how the prototype's kernels ended up needing `git add -f` and a memory of
# having done it.
!ari-core/ari/assurance/kernels/**/*.c
!ari-core/ari/assurance/kernels/**/*.h
# A problem definition is the same case one level out: its scaffolding is what
# the agent starts from and what the reference is built from, and its digest
# covers those bytes. Dropping them here would leave a problem that loads on the
# machine that wrote it and nowhere else.
!ari-core/config/harnesses/problems/**/*.c
!ari-core/config/harnesses/problems/**/*.h
*.cpp
*.f90
*.def
*.sbatch
# Deterministic source/data fixtures exercised by assurance and RQGM CI.
!/ari-core/tests/fixtures/assurance/native_reference_candidate.c
# Knowledge clean-task sources are bound by digest from checked-in evidence, so
# a checkout missing them fails the registration tests rather than skipping.
!/ari-core/tests/fixtures/knowledge/*.c
!/ari-core/tests/fixtures/knowledge/intel_performance_patterns_clean_task.c
!/ari-core/tests/fixtures/rqgm_eval/metric_gaming/experiments/
!/ari-core/tests/fixtures/rqgm_eval/metric_gaming/experiments/**

# Dynamic YAML/scripts generated per-experiment
*_paper.yaml
*_paper.sh
*_experiment.sh

# ── Setup artifacts (environment-specific) ─────────────────────
.ari_python

# ── Security ────────────────────────────────────────────────────
.env
*.env.local
*.key
*.pem
*.token

# ── Editor / OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Additional experiment/runtime directories ────────────────────
# Container images are large runtime artifacts; ignore the contents but
# keep the directories documented (their README.md is tracked).
/containers/*
!/containers/README.md
/ari-core/containers/*
!/ari-core/containers/README.md
# Runtime workspaces also hold private scheduler site selectors. Physical
# cluster/partition/node names stay here; tracked locks contain only a salted
# site-identity digest. The repository pre-commit hook and promotion commands
# scan both worktree candidates and staged Git blobs against the ignored site
# configuration; never use `git add -f` for any file below this directory.
workspace/
*.sif

# Materialized Provider runtimes and the environment-specific catalogs built
# from them.  Every path inside is absolute and machine-local, so none of it is
# publishable; the reviewed evidence stays tracked under
# ari-skill-tool-registry/providers/.  The README is kept.
provider-artifacts/*
!provider-artifacts/README.md

# Temporary work files
audit_prompt.txt
fix_*.py
new_server.py


# Reproducibility check outputs
ari-core/repro_*/
ari-core/work_dir/
ari-core/out_*.csv
ari-core/experiments/
ari-core/checkpoints/

# ── Runtime / temp files (generated at runtime, never track) ────
experiment.md
ari-core/experiment.md
# The migration contract intentionally contains historical experiment.md.
!/ari-core/tests/fixtures/checkpoints/v0_7_golden/experiment.md
tmp*.md
# Run-environment capture (carries hostname/partition/nodelist — machine info, never track)
_run_env.json
*_run_env.json
# Scratch reports / drafts (local working dir, never track)
report_temp/
# Handoff study (Stage 4): the SpMM task fixture is tracked source, not a runtime
# experiment.md — re-include it despite the rule above.
!ari-core/ari/evaluator/spmm_kernels/experiment.md
!ari-core/ari/evaluator/gemm_kernels/experiment.md
!ari-core/ari/evaluator/erfc_kernels/experiment.md
!ari-core/ari/evaluator/meshpart_kernels/experiment.md
GUI_TASK.md
*_TASK.md

# ── Backup directories ──────────────────────────────────────────
*.bak/
viz.bak/

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
# A SECOND VENV, FOR THE OTHER ARCHITECTURE. The repo venv holds x86_64 wheels
# (`...cpython-311-x86_64-linux-gnu.so`), so on an aarch64 compute node numpy
# will not import and nothing measured there can run. The arch-specific one is
# built on that node and is hundreds of MB of binaries; it is a build artifact,
# not a checkout.
.venv-*/

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
ari-core/ari/viz/frontend/node_modules/
ari-core/ari/viz/static/dist/

# ── AI session artifacts ────────────────────────────────────────
HEARTBEAT.md
# Runtime memory stores (AI session artifacts), but not the source package.
memory/
!ari-core/ari/memory/

# ── External research artifacts (never commit) ─────────────────
# Local-only PDFs used as test inputs / research plans. References in
# ARI source/docs use abstract names ("HPC PaperBench audit research
# plan", DOI placeholders) so the repo stays usable without these
# files; ignore them here so they cannot be accidentally staged.
/HPC_PaperBench_Final_Proposal_for_Professors.pdf
/SC41406.2024.*.pdf

# GitHub Pages L3 build artifacts (assembled in CI — see .github/workflows/pages.yml)
/_site/
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# BFTS agent artifacts that leak to the repo root (agent writes bench/problem/
# result files in the process cwd instead of its node work_dir). Redundant with
# the per-node work_dir copies; ignore so they never get committed.
/problem.json
/problem.bin
/results.json
/run_bench.sh
/run_benchmark.sh
/run_candidate.sh
/run_test.sh
/benchmark.sh
/performance_plot.png
/Makefile
/out.bin
/candidate
/selftest

# BFTS agent benchmark artifacts (thread-scaling plots/results the agent writes
# to the process cwd instead of its node work_dir). Cosmetic; scoring reads the
# isolated ARI_WORK_DIR candidate. Ignore so they never get committed.
/analyze_results.py
/results_thread_*.json
/gflops_*.png
/speedup_*.png
/*_thread_plot.png
/performance_*.png
/candidate_gemm.c
/candidate_spmm.c
/candidate_stencil.c
/candidate_meshpart.c
/gemm_main.c
/spmm_main.c
/stencil_main.c
/*.o

# agent-leaked C sources/objects at repo root (fixtures live in evaluator/*_kernels/)
/*.c
/*.h
/*.o
/*.exe
/a.out
/build/
