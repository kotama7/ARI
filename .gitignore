# ===========================
# ARI root-level .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/
.env
*.egg

# ── Experiment artifacts (NEVER track) ─────────────────────────
# SLURM job logs & error files
logs/
*.out
*.err
slurm-*.out

# Checkpoint directories (generated at runtime)
*_ckpt_*/
checkpoints/
output*/
results*/

# Experiment-specific source files (user-created, not part of ARI)
experiments/
benchmarks/
*.c
*.cpp
*.f90
*.def
*.sbatch
# Handoff study (B2b): the SpMM kernel fixtures are tracked source, not
# user-created experiment files — re-include them despite the *.c rule above.
!ari-core/ari/evaluator/spmm_kernels/*.c
# Handoff study (task A): GEMM kernel fixtures are likewise tracked source.
!ari-core/ari/evaluator/gemm_kernels/*.c
# Handoff study (task B / erfc Goldilocks): erfc fixtures are tracked source.
!ari-core/ari/evaluator/erfc_kernels/*.c
# Handoff study (task C / meshpart Goldilocks): partitioning fixtures are tracked.
!ari-core/ari/evaluator/meshpart_kernels/*.c

# Dynamic YAML/scripts generated per-experiment
*_paper.yaml
*_paper.sh
*_experiment.sh

# ── Setup artifacts (environment-specific) ─────────────────────
.ari_python

# ── Security ────────────────────────────────────────────────────
.env
*.env.local
*.key
*.pem
*.token

# ── Editor / OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Additional experiment/runtime directories ────────────────────
# Container images are large runtime artifacts; ignore the contents but
# keep the directories documented (their README.md is tracked).
/containers/*
!/containers/README.md
/ari-core/containers/*
!/ari-core/containers/README.md
workspace/
*.sif

# Temporary work files
audit_prompt.txt
fix_*.py
new_server.py


# Reproducibility check outputs
ari-core/repro_*/
ari-core/work_dir/
ari-core/out_*.csv
ari-core/experiments/
ari-core/checkpoints/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
dist/
build/

# ── Runtime / temp files (generated at runtime, never track) ────
experiment.md
ari-core/experiment.md
tmp*.md
# Run-environment capture (carries hostname/partition/nodelist — machine info, never track)
_run_env.json
*_run_env.json
# Scratch reports / drafts (local working dir, never track)
report_temp/
# Handoff study (Stage 4): the SpMM task fixture is tracked source, not a runtime
# experiment.md — re-include it despite the rule above.
!ari-core/ari/evaluator/spmm_kernels/experiment.md
!ari-core/ari/evaluator/gemm_kernels/experiment.md
!ari-core/ari/evaluator/erfc_kernels/experiment.md
!ari-core/ari/evaluator/meshpart_kernels/experiment.md
GUI_TASK.md
*_TASK.md

# ── Backup directories ──────────────────────────────────────────
*.bak/
viz.bak/

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
ari-core/ari/viz/frontend/node_modules/
ari-core/ari/viz/static/dist/

# ── Compiled binaries (experiment artifacts) ───────────────────
*.out

# ── AI session artifacts ────────────────────────────────────────
HEARTBEAT.md
# Runtime memory stores (AI session artifacts), but not the source package.
memory/
!ari-core/ari/memory/

# ── External research artifacts (never commit) ─────────────────
# Local-only PDFs used as test inputs / research plans. References in
# ARI source/docs use abstract names ("HPC PaperBench audit research
# plan", DOI placeholders) so the repo stays usable without these
# files; ignore them here so they cannot be accidentally staged.
/HPC_PaperBench_Final_Proposal_for_Professors.pdf
/SC41406.2024.*.pdf

# GitHub Pages L3 build artifacts (assembled in CI — see .github/workflows/pages.yml)
/_site/
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# BFTS agent artifacts that leak to the repo root (agent writes bench/problem/
# result files in the process cwd instead of its node work_dir). Redundant with
# the per-node work_dir copies; ignore so they never get committed.
/problem.json
/problem.bin
/results.json
/run_bench.sh
/run_benchmark.sh
/run_candidate.sh
/run_test.sh
/benchmark.sh
/performance_plot.png
/Makefile
/out.bin
/candidate
/selftest
