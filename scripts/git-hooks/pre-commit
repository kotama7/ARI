#!/usr/bin/env bash
# pre-commit — keep per-directory README `## Contents` indexes in sync with the
# tree. Runs scripts/readme_sync.py --write, then re-stages any *tracked*
# README.md it changed so the doc sync rides along with this commit.
#
# Properties:
#   - NEVER calls an LLM / network API (readme_sync is pure stdlib). New files
#     get a `— TODO` placeholder description; this hook only warns about them.
#   - Only re-stages README.md files that are ALREADY tracked and were modified
#     by --write. It never adds untracked files, so it won't sweep brand-new
#     READMEs into an unrelated commit.
#   - Non-blocking: a doc-tool failure must not stop a commit. CI's
#     `readme_sync.py --check` (.github/workflows/readme-sync.yml) is the gate.
#
# Enabled via `git config core.hooksPath scripts/git-hooks`.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script="$root/scripts/readme_sync.py"
[ -f "$script" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

if ! out="$(python3 "$script" --write 2>/dev/null)"; then
  echo "readme_sync: --write failed; committing without doc sync (CI --check will catch drift)." >&2
  exit 0
fi

# Re-stage ONLY the READMEs --write actually changed (it prints "updated <path>")
# AND that are already tracked — so unrelated pre-existing edits and brand-new
# untracked READMEs are never swept into this commit.
staged=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  if git -C "$root" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
    git -C "$root" add -- "$path" && staged=$((staged + 1))
  fi
done < <(printf '%s\n' "$out" | sed -n 's/^updated //p')
[ "$staged" -gt 0 ] && echo "readme_sync: synced $staged tracked README(s) into this commit." >&2

# Non-blocking heads-up if any placeholder description still needs writing.
if git -C "$root" grep -lI -e '— TODO' -- '*README.md' >/dev/null 2>&1; then
  echo "readme_sync: NOTE — some READMEs still have '— TODO' descriptions to fill in by hand." >&2
fi


# --- Harness pin drift -----------------------------------------------------
#
# A manifest pins the driver's content digest and the digest of the result
# schema ARI ships for that driver's report type. Both are computable, neither
# was computed by anything that wrote a manifest, so an edit to instrument code
# silently invalidated the pin and prepare() then refused the harness as
# "driver bytes drifted": registered, signed, and unable to run. That has
# happened three times in distinct episodes.
#
# Nothing occupied the pre-commit slot for it. The tests catch it, and CI runs
# them, but only after the commit exists -- and on a branch that is never
# pushed, never at all.
#
# BLOCKING, and only when the commit touches something a pin depends on. The
# trigger set is asked of the digest functions rather than listed here: a
# hand-list would drift from the digests the same way the manifests did, and it
# would drift silently, because a path missing from it just stops firing.
#
# It reads the WORKING TREE, not the index. A commit that stages a subset of
# its edits can therefore be judged on files it is not committing; the check
# says what it compared so that is visible rather than assumed.
if [ -z "${ARI_SKIP_PIN_CHECK:-}" ]; then
  repin="$root/scripts/rqgm_assurance/repin_and_promote_harness.py"
  # THE INTERPRETER IS NOT ALWAYS UNDER $root. In a linked worktree $root is the
  # worktree, which has the scripts but NOT the venv -- so `-x "$root/.venv/..."`
  # was false and the gate skipped in silence. That is exactly where promotions
  # are told to run, and where this session's own promotion commits were made:
  # the gate was absent from every commit it most needed to see. So the common
  # directory's venv is tried too, which for a linked worktree is the main
  # checkout's.
  python="${ARI_PYTHON:-}"
  if [ -z "$python" ]; then
    for candidate in \
      "$root/.venv/bin/python" \
      "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/../.venv/bin/python"
    do
      [ -x "$candidate" ] && { python="$candidate"; break; }
    done
  fi
  # FAIL LOUD WHEN THE GATE CANNOT RUN. Silence here is indistinguishable from
  # "checked and clean", which is the property that let the drift land three
  # times. A commit may still be made -- with ARI_SKIP_PIN_CHECK=1, said out
  # loud -- but not by accident.
  if [ -z "$python" ] || [ ! -f "$repin" ]; then
    echo "pin check: cannot run (no interpreter or missing $repin)." >&2
    echo "  Set ARI_PYTHON, or ARI_SKIP_PIN_CHECK=1 to commit without it." >&2
    exit 1
  fi
  if true; then
    staged_paths=$(git -C "$root" diff --cached --name-only)
    if [ -n "$staged_paths" ]; then
      watched=$("$python" "$repin" paths 2>/dev/null)
      if [ -n "$watched" ] \
         && printf '%s\n' "$staged_paths" | grep -qxF -f <(printf '%s\n' "$watched"); then
        if ! out=$("$python" "$repin" check 2>&1); then
          echo "" >&2
          echo "pin check: this commit touches code a Harness manifest pins, and a pin is stale:" >&2
          printf '%s\n' "$out" | sed 's/^/  /' >&2
          echo "" >&2
          echo "  A stale pin does not fail loudly. prepare() refuses the harness at run time" >&2
          echo "  with \"driver bytes drifted\", so it stays registered and signed and cannot run." >&2
          echo "" >&2
          echo "  Re-pin the manifest:" >&2
          echo "    scripts/rqgm_assurance/repin_and_promote_harness.py repin <manifest>.yaml" >&2
          echo "" >&2
          echo "  That moves manifest_digest, so the evidence bundle and the signature over" >&2
          echo "  it then have to be RE-EARNED by running the harness's controls. The re-pin" >&2
          echo "  surface names the attesting surface for the family; it writes no evidence" >&2
          echo "  itself, because it runs no controls." >&2
          echo "" >&2
          echo "  To commit anyway (the re-registration is a separate commit):" >&2
          echo "    ARI_SKIP_PIN_CHECK=1 git commit ..." >&2
          exit 1
        fi
      fi
    fi
  fi
fi

exit 0
